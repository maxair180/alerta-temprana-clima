# ===========================================================================
# DOCKERFILE BACKEND: .NET C# WEB API (LINUX CONTAINER)
# ===========================================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiar csproj y restaurar dependencias
COPY backend/ClimaApi/*.csproj backend/ClimaApi/
RUN dotnet restore backend/ClimaApi/ClimaApi.csproj

# Copiar todo el código y compilar en modo Release
COPY backend/ClimaApi/ backend/ClimaApi/
WORKDIR /src/backend/ClimaApi
RUN dotnet publish -c Release -o /app/publish /p:UseAppHost=false

# Imagen final de ejecución ligera
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

ENTRYPOINT ["dotnet", "ClimaApi.dll"]
