# ===========================================================================
# DOCKERFILE FRONTEND: ANGULAR 22+ SPA EN NGINX CON HTTPS
# ===========================================================================
FROM node:22-alpine AS build
WORKDIR /app

COPY frontend/clima-app/package*.json ./
RUN npm install

COPY frontend/clima-app/ ./
RUN node build.js

# Servidor web Nginx ligero para producción
FROM nginx:alpine AS runtime

# Generar certificado auto-firmado para HTTPS
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/nginx-selfsigned.key \
    -out /etc/nginx/ssl/nginx-selfsigned.crt \
    -subj "/C=GT/ST=Guatemala/L=Guatemala/O=ClimaSafe/OU=IT/CN=villacanales-clima.duckdns.org"

COPY --from=build /app/dist/clima-app/browser /usr/share/nginx/html

# Configuración de Nginx para Single Page Application (SPA), HTTPS y enrutamiento hacia API Gateway
RUN echo 'server { \
    listen 80; \
    server_name _; \
    return 301 https://$host$request_uri; \
} \
server { \
    listen 443 ssl; \
    server_name _; \
    ssl_certificate /etc/nginx/ssl/nginx-selfsigned.crt; \
    ssl_certificate_key /etc/nginx/ssl/nginx-selfsigned.key; \
    \
    # Enrutamiento hacia API Gateway (YARP / ASP.NET Core 10) \
    location /api/ { \
        proxy_pass http://gateway:8080/api/; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    location /hubs/ { \
        proxy_pass http://gateway:8080/hubs/; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
    } \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80 443

COPY docker/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]
